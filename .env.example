APP_ENV=development
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_VALIDATE_MODEL_ON_HEALTH=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-nano
DATABASE_URL=postgresql+psycopg://pmo_agent:password@postgres:5432/pmo_agent
ENCRYPTION_KEY=
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
MULTI_TENANT_ENABLED=true
MCP_BOARD_URL=http://mcp-board:8011/mcp
MCP_BOARD_TRANSPORT=streamable_http
MCP_BOARD_DOC_PATH=/opt/shared/mcp/board_pmo.md
MCP_TOOL_MAP_JSON=
MCP_TIMEOUT_SECONDS=15
MCP_READ_RETRIES=2
MCP_PERSISTENT_SESSIONS_ENABLED=true
MCP_SESSION_POOL_SIZE=2
# Fallback stdio local/desenvolvimento:
# MCP_BOARD_URL=docker compose -f /opt/board_pmo/docker-compose.yml exec -T api node apps/api/dist/mcp/server.js
# MCP_BOARD_TRANSPORT=stdio
AGENT_API_TOKEN=
AGENT_INTENT_CONFIDENCE_THRESHOLD=0.75
AGENT_DEFAULT_TENANT_ID=default
AGENT_DEFAULT_USER_ID=system
AGENT_DEFAULT_USER_ROLES=board.read,board.write,board.manage
AGENT_MAX_MESSAGE_CHARS=4000
AGENT_TOOL_RESULT_MAX_CHARS=12000
AGENT_THREAD_LOCK_TTL_SECONDS=60
AGENT_MEMORY_RETENTION_DAYS=90
AGENT_SESSION_TTL_MINUTES=1440
AGENT_PENDING_ACTION_TTL_MINUTES=15
AGENT_TASK_SELECTION_TTL_MINUTES=30
AGENT_MAX_UI_OPTIONS=12
AGENT_UPDATE_PAGE_SIZE=8
LEGACY_ENDPOINTS_ENABLED=false
V1_ENDPOINTS_ENABLED=true
V2_ENDPOINTS_ENABLED=true
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_WEB_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_INIT_ORG_ID=pmo-agent
LANGFUSE_INIT_ORG_NAME=PMO-Agent
LANGFUSE_INIT_PROJECT_ID=pmo-agent-api
LANGFUSE_INIT_PROJECT_NAME=PMO-Agent-API
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@pmo-agent.local
LANGFUSE_INIT_USER_NAME=PMO-Admin
LANGFUSE_INIT_USER_PASSWORD=
AGENT_API_PORT=8010
LOG_LEVEL=INFO
